{
  "name": "vitopaque",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=10.22.0 <11"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation next dev",
    "build": "NODE_OPTIONS=--no-deprecation next build",
    "payload": "NODE_OPTIONS=--no-deprecation payload",
    "db:migrate": "NODE_OPTIONS=--no-deprecation node --env-file=.env.local node_modules/payload/bin.js migrate",
    "db:status": "NODE_OPTIONS=--no-deprecation node --env-file=.env.local node_modules/payload/bin.js migrate:status",
    "db:migrate:create": "NODE_OPTIONS=--no-deprecation node --env-file=.env.local node_modules/payload/bin.js migrate:create",
    "generate:types": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@faceless-ui/modal": "3.0.2",
    "@faceless-ui/scroll-info": "2.0.0",
    "@mdx-js/loader": "3.1.1",
    "@next/mdx": "16.4.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-vercel-blob": "3.90.2",
    "@types/mdx": "2.0.14",
    "graphql": "16.14.2",
    "next": "16.4.0",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-boundaries": "7.2.0",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
