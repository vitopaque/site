# Copier vers .env.local. Ne jamais committer de valeurs réelles.

# Payload
PAYLOAD_SECRET=
# Supabase, pooler en mode transaction (port 6543)
DATABASE_URI=

# Vercel Blob (un store par environnement). Obligatoire sur Vercel ; en local, vide = disque local.
BLOB_READ_WRITE_TOKEN=

# URL canonique du site, sans slash final (metadataBase, serverURL et CSRF Payload).
# Obligatoire pour tout build hors développement (donc tout build Vercel) ; en développement, repli sur http://localhost:3000.
# Production : https://domaine.tld. Préproduction : l'URL *.vercel.app du déploiement, jamais le domaine de production.
SITE_URL=
